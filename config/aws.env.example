# ALFRED AWS production environment template.
# Copy these values into your AWS runtime secret/env store and replace every placeholder.

ALFRED_LOCAL_RUNTIME=false
DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=alfred.example.com
CSRF_TRUSTED_ORIGINS=https://alfred.example.com
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://alfred.example.com
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
ALFRED_SESSION_TIMEOUT_SECONDS=1800
ALFRED_SESSION_WARNING_SECONDS=300
SESSION_SAVE_EVERY_REQUEST=true
SESSION_EXPIRE_AT_BROWSER_CLOSE=true
SECURE_HSTS_SECONDS=31536000
SECURE_PROXY_SSL_HEADER_ENABLED=true
USE_X_FORWARDED_HOST=true
LOG_LEVEL=INFO

DB_ENGINE=django.db.backends.postgresql
DB_NAME=alfred
DB_USER=alfred
DB_PASSWORD=replace-with-rds-password
DB_HOST=replace-with-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_CONN_MAX_AGE=60

CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://replace-with-redis-host:6379/1
CACHE_KEY_PREFIX=alfred
CACHE_DEFAULT_TIMEOUT=300
REDIS_URL=redis://replace-with-redis-host:6379/0
CELERY_BROKER_URL=redis://replace-with-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://replace-with-redis-host:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
ALFRED_CELERY_PROBE_TIMEOUT_SECONDS=10
ALFRED_CELERY_BEAT_HEARTBEAT_MAX_AGE_SECONDS=900

ALFRED_AUTO_TRAIN_ON_STARTUP=true
ALFRED_AUTO_TRAIN_COOLDOWN_MINUTES=45
ALFRED_DELETE_SOURCE_UPLOADS_AFTER_EXTRACTION=true
ALFRED_PRODUCTION_DEPLOYMENT_PROOF=artifacts/ops/production_readiness_summary.json
ALFRED_MATERIALIZED_CACHE_TRAFFIC_PROOF=artifacts/cache/materialized_cache_traffic_summary.json
ALFRED_BROWSER_CI_CHROME_SUMMARY=artifacts/browser/browser_regression_summary.ci-chrome.json

AWS_REGION=ap-south-1
AWS_STORAGE_BUCKET_NAME=replace-with-private-artifact-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
