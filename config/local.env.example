# ALFRED local hosting environment.
# Copy this file to config/local.env and change DJANGO_SECRET_KEY before using real personal data.
#
# This profile is for local/LAN hosting, not public internet hosting. It intentionally keeps HTTPS-only
# browser settings disabled because localhost and LAN IPs are usually served over plain HTTP.

ALFRED_LOCAL_RUNTIME=false
DEBUG=false
DJANGO_SECRET_KEY=replace-this-local-hosting-secret
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
ALFRED_SESSION_TIMEOUT_SECONDS=3600
ALFRED_SESSION_WARNING_SECONDS=300
# Optional IANA time zone instead of the Windows system zone. Takes effect on restart:
# ALFRED_TIME_ZONE=Asia/Kolkata
SESSION_SAVE_EVERY_REQUEST=true
SESSION_EXPIRE_AT_BROWSER_CLOSE=true
SECURE_HSTS_SECONDS=0
# No reverse proxy here, so a LAN client must not be able to set these forwarded headers itself.
SECURE_PROXY_SSL_HEADER_ENABLED=false
USE_X_FORWARDED_HOST=false
LOG_LEVEL=INFO

DB_ENGINE=django.db.backends.postgresql
DB_NAME=alfred
DB_USER=alfred
DB_PASSWORD=alfred-local-postgres-password
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true

CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

ALFRED_AUTO_TRAIN_ON_STARTUP=false
ALFRED_DELETE_SOURCE_UPLOADS_AFTER_EXTRACTION=true
ALFRED_PRODUCTION_DEPLOYMENT_PROOF=artifacts/ops/local_readiness_summary.json
ALFRED_MATERIALIZED_CACHE_TRAFFIC_PROOF=artifacts/cache/materialized_cache_traffic_summary.json
ALFRED_BROWSER_CI_CHROME_SUMMARY=artifacts/browser/browser_regression_summary.ci-chrome.json

# Dormant knowledge-pack Git sync: separate approval, a reviewed private repository,
# least-privilege local credential and per-owner consent are required before activation.
# Career emails you approve one at a time, sent from your own mailbox (off while empty).
# Use an app password from your mail provider, never your account password. Gmail: smtp.gmail.com, port 587.
ALFRED_SMTP_HOST=
ALFRED_SMTP_PORT=587
ALFRED_SMTP_SSL=false
ALFRED_SMTP_USER=
ALFRED_SMTP_PASSWORD=
ALFRED_SMTP_FROM=
# Encrypted memory sync to Cloudflare R2 (off by default). Only ciphertext is uploaded.
ALFRED_MEMORY_SYNC_PROVIDER=
ALFRED_MEMORY_CLOUD_AUTHORIZED=false
ALFRED_MEMORY_R2_ACCOUNT_ID=
ALFRED_MEMORY_R2_BUCKET=
ALFRED_MEMORY_R2_ACCESS_KEY=
ALFRED_MEMORY_R2_SECRET_KEY=
ALFRED_MEMORY_R2_JURISDICTION=
# Encrypted backup copies to the same R2 bucket (off by default); see scripts/cloud_backup.py.
ALFRED_CLOUD_BACKUP_AUTHORIZED=false
ALFRED_KNOWLEDGE_GIT_AUTHORIZED=false
ALFRED_KNOWLEDGE_GIT_REMOTE=
ALFRED_KNOWLEDGE_GIT_TOKEN=
# Local AI limits (owner decision 2026-11-12). Ollama must run on this PC or a private LAN IP; a public host is refused.
ALFRED_OLLAMA_HOST=127.0.0.1
ALFRED_OLLAMA_PORT=11434
# Seconds one local AI request may take, and the most tokens it may write.
ALFRED_LOCAL_AI_TIMEOUT_SECONDS=300
ALFRED_LOCAL_AI_MAX_OUTPUT_TOKENS=4096
# num_ctx follows the model's own context window, capped here to bound RAM use.
ALFRED_LOCAL_AI_MAX_CONTEXT_TOKENS=32768
# Think before answering hard general/travel questions (puzzles, itineraries, optimisation): auto, on or off.
# Thinking tokens are extra to the answer budget; only models that report the thinking capability use them.
ALFRED_LOCAL_AI_THINKING=auto
ALFRED_LOCAL_AI_THINKING_TOKENS=3072
# Private document knowledge (Documents page).
ALFRED_DOCUMENT_KNOWLEDGE_MAX_DOCUMENTS=200
ALFRED_DOCUMENT_KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
ALFRED_DOCUMENT_KNOWLEDGE_MAX_TEXT_BYTES=4194304
ALFRED_DOCUMENT_KNOWLEDGE_MAX_STORAGE_BYTES=2147483648
ALFRED_DOCUMENT_KNOWLEDGE_RETENTION_DAYS=365
ALFRED_DOCUMENT_KNOWLEDGE_RESULT_LIMIT=24
