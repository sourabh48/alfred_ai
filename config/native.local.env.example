# Native Windows profile: copy to <data directory>/config/local.env only if absent.
# The native launcher owns SQLite, Huey, diskcache and the signing key.
# Keep config/native.env private and restore it with an existing database.
ALFRED_LOCAL_RUNTIME=true
DEBUG=false
ALFRED_AUTO_TRAIN_ON_STARTUP=false
ALFRED_DELETE_SOURCE_UPLOADS_AFTER_EXTRACTION=true
ALFRED_SESSION_TIMEOUT_SECONDS=3600
ALFRED_SESSION_WARNING_SECONDS=300
LOG_LEVEL=INFO
# Optional scanned credit-report OCR, after installing Tesseract:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Add provider configuration privately here; never copy real keys into this example.
# Knowledge-pack sync is dormant. Do not activate without separate approval.
ALFRED_KNOWLEDGE_GIT_AUTHORIZED=false
ALFRED_KNOWLEDGE_GIT_REMOTE=
ALFRED_KNOWLEDGE_GIT_TOKEN=
