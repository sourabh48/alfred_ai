# ALFRED strict AWS Free Tier environment template.
# Copy to /etc/alfred/alfred.env on the EC2 host and replace every placeholder.
# This template is for docker-compose.aws-free-tier.yml, where PostgreSQL and Redis
# run as Docker services on the same EC2 instance.

ALFRED_LOCAL_RUNTIME=false
DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=replace-with-ec2-public-dns-or-domain
CSRF_TRUSTED_ORIGINS=https://replace-with-domain
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://replace-with-domain
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
ALFRED_SESSION_TIMEOUT_SECONDS=1800
ALFRED_SESSION_WARNING_SECONDS=300
SESSION_SAVE_EVERY_REQUEST=true
SESSION_EXPIRE_AT_BROWSER_CLOSE=true
SECURE_HSTS_SECONDS=31536000
SECURE_PROXY_SSL_HEADER_ENABLED=true
USE_X_FORWARDED_HOST=true
LOG_LEVEL=INFO

DB_ENGINE=django.db.backends.postgresql
DB_NAME=alfred
DB_USER=alfred
DB_PASSWORD=replace-with-strong-local-postgres-password
DB_HOST=postgres
DB_PORT=5432

CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0

ALFRED_AUTO_TRAIN_ON_STARTUP=false
ALFRED_AUTO_TRAIN_COOLDOWN_MINUTES=45
ALFRED_DELETE_SOURCE_UPLOADS_AFTER_EXTRACTION=true
ALFRED_PRODUCTION_DEPLOYMENT_PROOF=artifacts/ops/production_readiness_summary.json
ALFRED_MATERIALIZED_CACHE_TRAFFIC_PROOF=artifacts/cache/materialized_cache_traffic_summary.json
ALFRED_BROWSER_CI_CHROME_SUMMARY=artifacts/browser/browser_regression_summary.ci-chrome.json

AWS_REGION=ap-south-1
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
