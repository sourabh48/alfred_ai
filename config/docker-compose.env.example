# Local production-style validation environment.
# This is intentionally not accepted as production proof because it disables HTTPS-only settings for localhost.

ALFRED_LOCAL_RUNTIME=false
DEBUG=false
DJANGO_SECRET_KEY=local-compose-only-replace-before-real-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO

DB_ENGINE=django.db.backends.postgresql
DB_NAME=alfred
DB_USER=alfred
DB_PASSWORD=alfred-local-postgres-password
DB_HOST=postgres
DB_PORT=5432

CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0

ALFRED_AUTO_TRAIN_ON_STARTUP=false
ALFRED_DELETE_SOURCE_UPLOADS_AFTER_EXTRACTION=true
ALFRED_PRODUCTION_DEPLOYMENT_PROOF=artifacts/ops/production_readiness_summary.json
ALFRED_MATERIALIZED_CACHE_TRAFFIC_PROOF=artifacts/cache/materialized_cache_traffic_summary.json
ALFRED_BROWSER_CI_CHROME_SUMMARY=artifacts/browser/browser_regression_summary.ci-chrome.json
