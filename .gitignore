# =========================
# Python / Django
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
db.sqlite3

# Django media & static build
/media/
/staticfiles/

# =========================
# Virtual Environments
# =========================
.venv/
alfred_env/
venv/
.env
.env.*
!.env.example
env/

# =========================
# ML Models & Artifacts
# =========================
ml_models/alfred/model_registry/registry.json
ml_models/**/model.pt
ml_models/**/model.bin
ml_models/**/model.pkl
ml_models/**/model.json
ml_models/**/model.safetensors
ml_models/alfred/model_registry/.registry.lock
ml_models/speech/
ml_models/**/weights/
ml_models/**/checkpoints/

# Embeddings & memory (generated, sensitive)
ml_models/alfred/memory/embeddings_store/
ml_models/alfred/memory/users/

# =========================
# Logs & Reports
# =========================
*.log
.coverage
.coverage.*
coverage.xml
.pytest_cache/
.hypothesis/
.tox/
.nox/
.cache/
.mypy_cache/
.ruff_cache/
logs/
reports/generated/
# Generated/runtime evidence stays local; reviewed audit/reinstall documents are source.
/artifacts/*
!/artifacts/audit/
/artifacts/audit/*
!/artifacts/audit/*.md
!/artifacts/reinstall/
/artifacts/reinstall/*
!/artifacts/reinstall/*.md
# Generated final verification receipt records the final commit without self-reference.
/artifacts/reinstall/PRE_REINSTALL_FINAL_STATUS.md
graphify-out/
runtime/
diskcache/
screenshots/
downloads/
htmlcov/

# =========================
# Celery / Redis
# =========================
celerybeat-schedule
celerybeat.pid

# =========================
# IDE / OS
# =========================
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
/ALFRED.lnk
python-installer.exe
*.tmp
*.temp
*.bak
*.orig
*.old
*.copy
*.iml

# =========================
# Node / PWA / Mobile (later)
# =========================
node_modules/
dist/
release/
build/
.parcel-cache/
.turbo/
android/
ios/

# =========================
# Secrets
# =========================
.env
*.key
*.pem

# =========================
# Local UI / runtime config
# =========================
config/alfred_ui.json
config/*.local.json
config/*.env
!config/*.example.json
!config/*.env.example
# Claude aliases here are absolute junctions into this machine's skill directory.
/.claude/skills/
# Session worktrees, personal settings and scheduler state are per machine.
/.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# =========================
# Local databases, backups and built packages
# =========================
# Any local database or dump can hold private records.
*.sqlite
*.sqlite-*
*.db
*.db-*
*.dump
# Git bundles, archives and installers are backups or release outputs, never source.
*.bundle
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.whl
*.exe
*.msi
*.lnk
# Office lock files and notebook checkpoints
~$*
.ipynb_checkpoints/
*.egg-info/

# Code-signing material and local signing configuration never enter the repository
*.pfx
*.p12
*.snk
signing-config*.json
